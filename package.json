{
  "name": "wikipedia-interface-language-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E test: an authorised Wikipedia user switches the interface language in Preferences",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "auth": "playwright test --project=setup --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm --build e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
